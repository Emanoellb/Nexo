<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativa até o Android 11: fundo Surface + símbolo do Nexo (128 dp),
     no mesmo tamanho e posição em que a splash do Flutter começa. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/nexo_splash_background" />
    <item
        android:width="128dp"
        android:height="128dp"
        android:drawable="@drawable/ic_splash_symbol"
        android:gravity="center" />
</layer-list>
