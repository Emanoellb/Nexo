rules_version = '2';

// Regras do Cloud Firestore do Nexo (MVP).
// Contrato de campos e decisões: docs/backend/firestore-rules.md.
// Testes: firestore_tests/ (rodam no emulador só antes de cada deploy).
//
// Princípios:
// - Todo dado pessoal fica sob users/{uid}; só o dono lê e grava, e só com
//   e-mail verificado. Exceção: criar users/{uid} no Cadastro (aceite + idade).
// - Sem Cloud Function no MVP (decisão do usuário, para não gastar créditos):
//   o app grava e calcula dias, pontos e conquistas; as regras validam formato
//   e limites. Cada documento tem uma lista branca de campos.
// - createdAt e updatedAt usam FieldValue.serverTimestamp() (== request.time).
// - Notificações são locais (no aparelho): nada de token FCM no Firestore.
// - Exclusão de plano e de conta é feita pelo app: marcar "excluindo" libera
//   apagar os dados que normalmente são imutáveis.
// - Sem regra que permita, o acesso é negado.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções comuns ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Dono com e-mail verificado. O Google já entrega o e-mail verificado;
    // na conta de e-mail e senha, o app renova o token (getIdToken(true))
    // depois da tela 05 para a regra enxergar a verificação.
    function isVerifiedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    // Campos alterados num update (incluídos, removidos ou modificados).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Create: só campos permitidos, todos os obrigatórios e os carimbos de tempo.
    function validCreate(allowed, required) {
      return incoming().keys().hasOnly(allowed)
        && incoming().keys().hasAll(required)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }

    // Update: só mexe em campos permitidos, não troca createdAt e renova updatedAt.
    function validUpdate(allowed) {
      return changedKeys().hasOnly(allowed)
        && !('createdAt' in changedKeys())
        && incoming().updatedAt == request.time;
    }

    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isTextOrNull(v, min, max) {
      return v == null || isText(v, min, max);
    }

    // Data civil AAAA-MM-DD (sem fuso).
    function isDate(v) {
      return v is string
        && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isDateOrNull(v) {
      return v == null || isDate(v);
    }

    // Horário HH:mm (24 h).
    function isTime(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isTimestampOrNull(v) {
      return v == null || v is timestamp;
    }

    function isIntBetween(v, min, max) {
      return v is int && v >= min && v <= max;
    }

    function isListUpTo(v, max) {
      return v is list && v.size() <= max;
    }

    // Campo antigo, fora do contrato atual: o update pode deixá-lo como está
    // ou removê-lo, mas não criar nem alterar.
    function onlyRemoves(field) {
      return !(field in changedKeys()) || !(field in incoming());
    }

    // Lista de 0 a 3 itens sem repetidos.
    function isDistinctListUpTo3(v) {
      return v is list && v.size() <= 3 && v.toSet().size() == v.size();
    }

    // Tolerância para relógio do aparelho adiantado.
    function notInFuture(t) {
      return t.toMillis() <= request.time.toMillis() + 5 * 60 * 1000;
    }

    // Data AAAA-MM-DD como timestamp (meia-noite UTC).
    function dateAt(v) {
      let p = v.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    // Até 7 dias antes de hoje no fuso do usuário. As regras só conhecem o
    // UTC, então aceitam até 9 dias (folga para qualquer fuso).
    function notBeforeLastWeek(v) {
      return dateAt(v) >= request.time - duration.value(9, 'd');
    }

    // Janela de 7 dias para registrar, editar e finalizar (RF11, RF14):
    // de 7 dias atrás até hoje no fuso do usuário (amanhã em UTC, de folga).
    function inLastWeek(v) {
      return isDate(v)
        && notBeforeLastWeek(v)
        && dateAt(v) <= request.time + duration.value(1, 'd');
    }

    // ---------- Dados pessoais: users/{uid} ----------

    match /users/{uid} {

      function userPath() {
        return /databases/$(database)/documents/users/$(uid);
      }

      // Conta marcada para exclusão (Excluir conta, feito pelo app).
      function userDeleting() {
        return get(userPath()).data.get('deletionRequestedAt', null) != null;
      }

      // birthDate entra só na criação: o app não altera (correção pelo
      // canal de contato). points é mantido pelo app (sem Function no MVP).
      // morningSummary: aviso da manhã do Perfil (notificação local).
      // Tema, "Não perturbe ao focar" e "Reduzir transparência" ficam só no
      // aparelho (decisão de 07/11/2026).
      function userEditableFields() {
        return ['displayName', 'timeZone', 'tutorialSeen', 'primaryPlanId',
                'overloadThreshold', 'morningSummary', 'points', 'consents',
                'deletionRequestedAt', 'createdAt', 'updatedAt'];
      }

      function userCreateFields() {
        return ['displayName', 'birthDate', 'timeZone', 'tutorialSeen',
                'overloadThreshold', 'morningSummary', 'points', 'consents',
                'createdAt', 'updatedAt'];
      }

      // Aviso da manhã: {enabled, time "HH:mm"}. Sem o campo, o app usa o
      // padrão {true, "08:00"}.
      function validMorningSummary(m) {
        return m is map
          && m.keys().hasOnly(['enabled', 'time'])
          && m.keys().hasAll(['enabled', 'time'])
          && m.enabled is bool
          && isTime(m.time);
      }

      function userRequired() {
        return ['displayName', 'birthDate', 'timeZone', 'consents',
                'createdAt', 'updatedAt'];
      }

      // Plano principal (RF07): um campo só no usuário garante um principal.
      // Aponta para um plano do próprio usuário, que pode estar sendo criado
      // na mesma operação (existsAfter).
      function validPrimaryPlan(d) {
        return d.get('primaryPlanId', null) == null
          || (isText(d.primaryPlanId, 1, 128)
              && existsAfter(/databases/$(database)/documents/users/$(uid)/plans/$(d.primaryPlanId)));
      }

      // Idade mínima de 16 anos (D1), pela data UTC do servidor.
      // Quem nasceu em 29/02 completa 16 anos em 01/03 nos anos não bissextos.
      function isAtLeast16(birthDate) {
        let parts = birthDate.split('-');
        let year = int(parts[0]);
        let month = int(parts[1]);
        let day = int(parts[2]);
        return year >= 1900
          && (year + 16 < request.time.year()
              || (year + 16 == request.time.year()
                  && (month < request.time.month()
                      || (month == request.time.month() && day <= request.time.day()))));
      }

      // Versões vigentes dos Termos e da Política (escritas pelo console).
      function currentLegal() {
        return get(/databases/$(database)/documents/legalDocuments/current).data;
      }

      // Aceite dos Termos e da Política: versões vigentes + data/hora do servidor.
      function validConsents(c) {
        return c is map
          && c.keys().hasOnly(['termsVersion', 'privacyVersion', 'acceptedAt'])
          && c.keys().hasAll(['termsVersion', 'privacyVersion', 'acceptedAt'])
          && c.termsVersion == currentLegal().termsVersion
          && c.privacyVersion == currentLegal().privacyVersion
          && c.acceptedAt == request.time;
      }

      // Valida os campos do app presentes no documento final.
      // overloadThreshold: tarefas por dia para "sobrecarregado" (padrão 5 no app).
      function validUser(d) {
        return isText(d.displayName, 1, 80)
          && isText(d.timeZone, 1, 64)
          && d.timeZone.matches('^[A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2}$')
          && d.get('tutorialSeen', false) is bool
          && (d.get('overloadThreshold', null) == null
              || isIntBetween(d.overloadThreshold, 1, 20))
          && (d.get('morningSummary', null) == null
              || validMorningSummary(d.morningSummary))
          && isIntBetween(d.get('points', 0), 0, 10000000);
      }

      allow read: if isVerifiedOwner(uid);

      // Sem aceite e sem idade não existe documento do usuário.
      // Única gravação permitida antes de verificar o e-mail: o Cadastro grava
      // o aceite no momento do clique. Começa com 0 pontos.
      allow create: if isOwner(uid)
        && validCreate(userCreateFields(), userRequired())
        && validUser(incoming())
        && incoming().get('points', 0) == 0
        && isDate(incoming().birthDate)
        && isAtLeast16(incoming().birthDate)
        && validConsents(incoming().consents);

      // Novo aceite (nova versão) só com acceptedAt do servidor.
      // A marcação de exclusão é feita uma vez, com a hora do servidor.
      allow update: if isVerifiedOwner(uid)
        && validUpdate(userEditableFields())
        && validUser(incoming())
        && (!('consents' in changedKeys()) || validConsents(incoming().consents))
        && (!('primaryPlanId' in changedKeys()) || validPrimaryPlan(incoming()))
        && (!('deletionRequestedAt' in changedKeys())
            || (resource.data.get('deletionRequestedAt', null) == null
                && incoming().deletionRequestedAt == request.time));

      // Excluir conta (pelo app): o documento do usuário é o último a sair,
      // depois de todas as subcoleções; em seguida o app apaga a conta do Auth.
      allow delete: if isVerifiedOwner(uid)
        && resource.data.get('deletionRequestedAt', null) != null;

      // ----- Objetivos -----
      match /goals/{goalId} {
        function goalFields() {
          return ['name', 'description', 'deadline', 'createdAt', 'updatedAt'];
        }

        function validGoal(d) {
          return isText(d.name, 1, 80)
            && isTextOrNull(d.get('description', null), 0, 500)
            && isDateOrNull(d.get('deadline', null));
        }

        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validCreate(goalFields(), ['name', 'createdAt', 'updatedAt'])
          && validGoal(incoming());
        allow update: if isVerifiedOwner(uid)
          && validUpdate(goalFields())
          && validGoal(incoming());
      }

      // ----- Planos de ação -----
      match /plans/{planId} {

        function planPath() {
          return /databases/$(database)/documents/users/$(uid)/plans/$(planId);
        }

        // Plano apagado ou marcado "excluindo": libera apagar sessões, dias
        // e versões (o app limpa em lotes; se fechar no meio, retoma depois).
        // Tópicos podem ser apagados a qualquer momento.
        function planGone() {
          return !exists(planPath()) || get(planPath()).data.status == 'deleting';
        }

        // Plano existe e não está sendo excluído. Usado no create dos filhos:
        // o get falha (nega) se o plano não existe, então substitui o exists.
        function planOpen() {
          return get(planPath()).data.status != 'deleting';
        }

        // Mesma checagem, vendo o lote inteiro (plano criado junto).
        function planOpenAfter() {
          return getAfter(planPath()).data.status != 'deleting';
        }

        // Frequência: todos os dias, dias da semana (1 = segunda … 7 = domingo,
        // como o DateTime.weekday do Dart) ou X vezes por semana. A semana do
        // Nexo vai de domingo a sábado; isso só afeta a contagem do
        // "× por semana" e o calendário, não estes números.
        function validFrequency(f) {
          return f is map
            && f.keys().hasAll(['type'])
            && (
              (f.type == 'daily' && f.keys().hasOnly(['type']))
              || (f.type == 'weekdays'
                  && f.keys().hasOnly(['type', 'weekdays'])
                  && f.weekdays is list
                  && f.weekdays.size() >= 1 && f.weekdays.size() <= 7
                  && f.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7]))
              || (f.type == 'timesPerWeek'
                  && f.keys().hasOnly(['type', 'timesPerWeek'])
                  && isIntBetween(f.timesPerWeek, 1, 7))
            );
        }

        // frequency e dailyGoalMinutes são a cópia da configuração mais
        // recente; o histórico com vigência fica em scheduleVersions (RF04).
        // Totais da Visão geral são calculados pelo app a partir dos dias.
        // studyTime ("Horário do plano") e reminderBefore ("Avisar antes do
        // horário") substituem o antigo reminder {enabled, time} (v0.9,
        // 07/11/2026). Sem os campos, o app usa os padrões "19:00" e
        // {true, 15}. goalId continua opcional (no máximo um objetivo).
        function planFields() {
          return ['name', 'startDate', 'endDate', 'frequency', 'dailyGoalMinutes',
                  'status', 'pauses', 'endedOn', 'goalId', 'studyTime',
                  'reminderBefore', 'createdAt', 'updatedAt'];
        }

        function planRequired() {
          return ['name', 'startDate', 'endDate', 'frequency', 'dailyGoalMinutes',
                  'status', 'createdAt', 'updatedAt'];
        }

        // Antecedência do aviso: na hora, 15, 30 ou 60 minutos antes.
        function validReminderBefore(r) {
          return r is map
            && r.keys().hasOnly(['enabled', 'minutesBefore'])
            && r.keys().hasAll(['enabled', 'minutesBefore'])
            && r.enabled is bool
            && r.minutesBefore in [0, 15, 30, 60];
        }

        // Período de até 2 anos. endedOn ("encerrar antes", RF06) fica dentro do
        // período e é obrigatório quando o status é endedEarly; continua no
        // documento se o plano for arquivado depois.
        // pauses (RF05): lista de {start, end} em datas; as regras validam só
        // o tamanho. status 'deleting' = exclusão em andamento.
        function validPlan(d) {
          return isText(d.name, 1, 80)
            && isDate(d.startDate)
            && isDate(d.endDate)
            && d.endDate >= d.startDate
            && dateAt(d.endDate) <= dateAt(d.startDate) + duration.value(731, 'd')
            && validFrequency(d.frequency)
            && isIntBetween(d.dailyGoalMinutes, 1, 1440)
            && d.status in ['active', 'paused', 'completed', 'endedEarly', 'archived', 'deleting']
            && (d.get('endedOn', null) == null
                || (isDate(d.endedOn) && d.endedOn >= d.startDate && d.endedOn <= d.endDate))
            && (d.status != 'endedEarly' || d.get('endedOn', null) != null)
            && (d.get('pauses', null) == null || isListUpTo(d.pauses, 100))
            && isTextOrNull(d.get('goalId', null), 1, 128)
            && (d.get('studyTime', null) == null || isTime(d.studyTime))
            && (d.get('reminderBefore', null) == null || validReminderBefore(d.reminderBefore));
        }

        allow read: if isVerifiedOwner(uid);
        // Início até 7 dias para trás (decisão de 22/10/2026).
        allow create: if isVerifiedOwner(uid)
          && validCreate(planFields(), planRequired())
          && validPlan(incoming())
          && incoming().status != 'deleting'
          && notBeforeLastWeek(incoming().startDate);
        // 'deleting' é terminal: o plano marcado fica congelado e só sai
        // apagando. Sem isso, um cliente modificado marcaria 'deleting',
        // apagaria o histórico antigo (planGone) e voltaria para 'active'.
        // Plano antigo com reminder (antes da v0.9): pode removê-lo, não alterar.
        allow update: if isVerifiedOwner(uid)
          && resource.data.status != 'deleting'
          && validUpdate(planFields().concat(['reminder']))
          && onlyRemoves('reminder')
          && validPlan(incoming())
          && (!('startDate' in changedKeys()) || notBeforeLastWeek(incoming().startDate));
        // O plano principal não fica apontando para um plano apagado: o app
        // limpa users.primaryPlanId na mesma operação.
        allow delete: if isVerifiedOwner(uid)
          && getAfter(userPath()).data.get('primaryPlanId', null) != planId;

        // Histórico de alterações com vigência (RF04). Imutável para o app.
        // A configuração inicial também é uma versão (effectiveFrom = início),
        // criada junto com o plano: por isso existsAfter/getAfter.
        // Edições valem a partir do dia seguinte (regra do app).
        match /scheduleVersions/{versionId} {
          function validVersion(v, plan) {
            return v.keys().hasOnly(['effectiveFrom', 'frequency', 'dailyGoalMinutes', 'createdAt'])
              && v.keys().hasAll(['effectiveFrom', 'frequency', 'dailyGoalMinutes', 'createdAt'])
              && isDate(v.effectiveFrom)
              && v.effectiveFrom >= plan.startDate
              && v.effectiveFrom <= plan.endDate
              && validFrequency(v.frequency)
              && isIntBetween(v.dailyGoalMinutes, 1, 1440)
              && v.createdAt == request.time;
          }

          allow read: if isVerifiedOwner(uid);
          allow create: if isVerifiedOwner(uid)
            && existsAfter(planPath())
            && planOpenAfter()
            && validVersion(incoming(), getAfter(planPath()).data);
          allow update: if false;
          allow delete: if isVerifiedOwner(uid) && (planGone() || userDeleting());
        }

        // Tópicos próprios do plano (RF10). Um tópico pode reaproveitar uma
        // disciplina (subjectId) ou ser novo, só deste plano. Criados junto
        // com o plano ou depois: por isso existsAfter.
        match /topics/{topicId} {
          function topicFields() {
            return ['name', 'subjectId', 'createdAt', 'updatedAt'];
          }

          function validTopic(d) {
            return isText(d.name, 1, 80)
              && isTextOrNull(d.get('subjectId', null), 1, 128);
          }

          allow read: if isVerifiedOwner(uid);
          allow create: if isVerifiedOwner(uid)
            && existsAfter(planPath())
            && planOpenAfter()
            && validCreate(topicFields(), ['name', 'createdAt', 'updatedAt'])
            && validTopic(incoming());
          allow update: if isVerifiedOwner(uid)
            && validUpdate(topicFields())
            && validTopic(incoming());
          allow delete: if isVerifiedOwner(uid);
        }

        // Sessões de foco e registros manuais (RF08–RF13).
        // O cronômetro em andamento fica no aparelho: a sessão só é gravada
        // ao encerrar. A sessão que cruza a meia-noite é dividida pelo app.
        // Criar, editar e excluir: só dentro da janela de 7 dias.
        match /sessions/{sessionId} {
          function sessionFields() {
            return ['startAt', 'endAt', 'durationSeconds', 'source', 'topicIds',
                    'note', 'day', 'createdAt', 'updatedAt'];
          }

          function topicPath(topicId) {
            return /databases/$(database)/documents/users/$(uid)/plans/$(planId)/topics/$(topicId);
          }

          // Cada id existe em topics do próprio plano (o tópico pode ser
          // criado no mesmo lote: existsAfter). Até 3 leituras, só quando a
          // lista muda.
          function topicIdsExist(t) {
            return (t.size() < 1 || existsAfter(topicPath(t[0])))
              && (t.size() < 2 || existsAfter(topicPath(t[1])))
              && (t.size() < 3 || existsAfter(topicPath(t[2])));
          }

          function validTopicIds(t) {
            return isDistinctListUpTo3(t)
              && (t.size() < 1 || isText(t[0], 1, 128))
              && (t.size() < 2 || isText(t[1], 1, 128))
              && (t.size() < 3 || isText(t[2], 1, 128));
          }

          function sessionRequired() {
            return ['startAt', 'endAt', 'durationSeconds', 'source', 'day',
                    'createdAt', 'updatedAt'];
          }

          // Até 24 h; duração líquida (sem pausas) <= fim - início.
          // topicIds: 0 a 3 tópicos do próprio plano, sem repetidos (v0.9).
          // As horas por tópico (duração ÷ número de tópicos) são do app.
          function validSession(d) {
            return d.startAt is timestamp
              && d.endAt is timestamp
              && d.endAt > d.startAt
              && notInFuture(d.endAt)
              && d.endAt.toMillis() - d.startAt.toMillis() <= 24 * 60 * 60 * 1000
              && d.durationSeconds is int
              && d.durationSeconds > 0
              && d.durationSeconds * 1000 <= d.endAt.toMillis() - d.startAt.toMillis()
              && d.source in ['focus', 'manual']
              && inLastWeek(d.day)
              && (d.get('topicIds', null) == null || validTopicIds(d.topicIds))
              && isTextOrNull(d.get('note', null), 1, 500);
          }

          allow read: if isVerifiedOwner(uid);
          allow create: if isVerifiedOwner(uid)
            && exists(planPath())
            && planOpen()
            && validCreate(sessionFields(), sessionRequired())
            && validSession(incoming())
            && (incoming().get('topicIds', null) == null || topicIdsExist(incoming().topicIds));
          // Sessão antiga com topicId (antes da v0.9): pode removê-lo, não alterar.
          allow update: if isVerifiedOwner(uid)
            && inLastWeek(resource.data.day)
            && validUpdate(sessionFields().concat(['topicId']))
            && onlyRemoves('topicId')
            && validSession(incoming())
            && (!('topicIds' in changedKeys())
                || incoming().get('topicIds', null) == null
                || topicIdsExist(incoming().topicIds));
          allow delete: if isVerifiedOwner(uid)
            && (inLastWeek(resource.data.day) || planGone() || userDeleting());
        }

        // Dia do plano (RF14–RF17), gravado pelo app. O id é a data local.
        // doneMinutes: soma das sessões do dia (atualizada no mesmo lote).
        // finalizedAt: hora do servidor ao finalizar; null no Desfazer.
        // Meta, status e pontos do dia são calculados pelo app (não guardados).
        match /days/{day} {
          function dayFields() {
            return ['doneMinutes', 'finalizedAt', 'createdAt', 'updatedAt'];
          }

          function validDay(d) {
            return isIntBetween(d.doneMinutes, 0, 1440)
              && isTimestampOrNull(d.finalizedAt);
          }

          allow read: if isVerifiedOwner(uid);
          allow create: if isVerifiedOwner(uid)
            && inLastWeek(day)
            && exists(planPath())
            && planOpen()
            && validCreate(dayFields(), dayFields())
            && validDay(incoming())
            && (incoming().finalizedAt == null || incoming().finalizedAt == request.time);
          allow update: if isVerifiedOwner(uid)
            && inLastWeek(day)
            && validUpdate(dayFields())
            && validDay(incoming())
            && (!('finalizedAt' in changedKeys())
                || incoming().finalizedAt == null
                || incoming().finalizedAt == request.time);
          allow delete: if isVerifiedOwner(uid) && (planGone() || userDeleting());
        }
      }

      // ----- Tarefas -----
      // Avisos de entrega próxima: notificações locais, até 3 por tarefa
      // (remindersMinutesBefore, v0.9): cada um de 1 a 43.200 minutos antes
      // do prazo (até 30 dias), sem repetidos, só com prazo. Notas ficam fora
      // do MVP. Tarefa antiga com reminderMinutesBefore pode removê-lo.
      // deliveryStatus (situação da entrega), coerente com a conclusão:
      // pendente = notStarted | inProgress; concluída = delivered | awaitingGrade.
      match /tasks/{taskId} {
        function taskFields() {
          return ['title', 'subjectId', 'dueAt', 'priority', 'completed',
                  'completedAt', 'remindersMinutesBefore', 'deliveryStatus',
                  'createdAt', 'updatedAt'];
        }

        function validReminders(r) {
          return isDistinctListUpTo3(r)
            && (r.size() < 1 || isIntBetween(r[0], 1, 43200))
            && (r.size() < 2 || isIntBetween(r[1], 1, 43200))
            && (r.size() < 3 || isIntBetween(r[2], 1, 43200));
        }

        function validDeliveryStatus(d) {
          return d.get('deliveryStatus', null) == null
            || (d.completed == false && d.deliveryStatus in ['notStarted', 'inProgress'])
            || (d.completed == true && d.deliveryStatus in ['delivered', 'awaitingGrade']);
        }

        function taskRequired() {
          return ['title', 'priority', 'completed', 'completedAt',
                  'createdAt', 'updatedAt'];
        }

        // completedAt existe só se concluída e é a hora do servidor quando muda.
        function validTask(d, completedAtChanged) {
          return isText(d.title, 1, 200)
            && isTextOrNull(d.get('subjectId', null), 1, 128)
            && isTimestampOrNull(d.get('dueAt', null))
            && d.priority in ['high', 'medium', 'low', 'none']
            && d.completed is bool
            && (d.completed == (d.completedAt != null))
            && (!completedAtChanged || d.completedAt == null || d.completedAt == request.time)
            && (d.get('remindersMinutesBefore', null) == null
                || (validReminders(d.remindersMinutesBefore)
                    && (d.remindersMinutesBefore.size() == 0 || d.get('dueAt', null) != null)))
            && validDeliveryStatus(d);
        }

        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validCreate(taskFields(), taskRequired())
          && validTask(incoming(), true);
        allow update: if isVerifiedOwner(uid)
          && validUpdate(taskFields().concat(['reminderMinutesBefore']))
          && onlyRemoves('reminderMinutesBefore')
          && validTask(incoming(), 'completedAt' in changedKeys());
      }

      // ----- Disciplinas -----
      // "8 de 12 entregas" e próxima entrega: calculados pelo app a partir
      // das tarefas da disciplina. icon: nome do ícone Lucide.
      // Cor por disciplina saiu do MVP (decisão de 04/11/2026). Documento
      // antigo que ainda tenha color pode ser editado sem mexer nela, ou
      // removê-la; criar ou alterar a cor é negado.
      match /subjects/{subjectId} {
        function subjectFields() {
          return ['name', 'icon', 'createdAt', 'updatedAt'];
        }

        function validSubject(d) {
          return isText(d.name, 1, 80)
            && isText(d.icon, 1, 64);
        }

        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validCreate(subjectFields(), subjectFields())
          && validSubject(incoming());
        allow update: if isVerifiedOwner(uid)
          && validUpdate(subjectFields().concat(['color']))
          && (!('color' in changedKeys()) || !('color' in incoming()))
          && validSubject(incoming());
      }

      // ----- Conquistas: o app grava, só as do catálogo -----
      match /achievements/{achievementId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && exists(/databases/$(database)/documents/achievementsCatalog/$(achievementId))
          && incoming().keys().hasOnly(['earnedAt'])
          && incoming().keys().hasAll(['earnedAt'])
          && incoming().earnedAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedOwner(uid) && userDeleting();
      }
    }

    // ---------- Conteúdo do app (sem dado pessoal) ----------

    // Catálogo de medalhas (até 8 no MVP): leitura para quem está logado.
    // Carregado pelo console.
    match /achievementsCatalog/{achievementId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Versões dos Termos e da Política: leitura pública (a tela de Cadastro
    // mostra a versão antes de a conta existir). legalDocuments/current
    // aponta as versões vigentes: {termsVersion, privacyVersion}.
    match /legalDocuments/{version} {
      allow read: if true;
      allow write: if false;
    }
  }
}
